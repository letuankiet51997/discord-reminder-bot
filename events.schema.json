{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discord-event-bot events.json",
  "description": "Reminder messages posted to one Discord channel through a webhook. Times are Vietnam time (Asia/Ho_Chi_Minh).",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "title",
        "time"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Bold headline of the reminder."
        },
        "time": {
          "type": "string",
          "description": "\"HH:MM\" for daily. \"YYYY-MM-DD HH:MM\" or \"DD/MM/YYYY HH:MM\" for weekly and monthly: the date sets the weekday (weekly) or the day of month (monthly).",
          "pattern": "^(\\d{1,2}:\\d{2}|\\d{4}-\\d{1,2}-\\d{1,2} \\d{1,2}:\\d{2}|\\d{1,2}/\\d{1,2}/\\d{4} \\d{1,2}:\\d{2})$"
        },
        "repeat": {
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ],
          "default": "daily"
        },
        "role": {
          "type": "string",
          "description": "Who to ping: a role alias declared in the DISCORD_ROLES environment variable (e.g. \"dev\"), \"everyone\" or \"here\". Never a role id. Omit for no ping.",
          "pattern": "^@?[A-Za-z0-9_-]{1,32}$"
        },
        "message": {
          "type": "string",
          "description": "Extra text shown under the title."
        }
      },
      "if": {
        "properties": {
          "repeat": {
            "enum": [
              "weekly",
              "monthly"
            ]
          }
        },
        "required": [
          "repeat"
        ]
      },
      "then": {
        "properties": {
          "time": {
            "not": {
              "pattern": "^\\d{1,2}:\\d{2}$"
            }
          }
        }
      }
    }
  }
}
